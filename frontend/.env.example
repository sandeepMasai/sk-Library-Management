# Copy to .env and restart Expo: npx expo start -c
#
# IMPORTANT — Cloudinary uploads go through the BACKEND, not the app.
# Whichever API URL you set here decides which Cloudinary account is used.
#
# Production API (default):
EXPO_PUBLIC_API_URL=https://api.smartlibdesk.in
#
# Local backend on Mac (same Wi‑Fi as phone; use your Mac LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.42:1998
