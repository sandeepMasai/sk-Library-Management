# Copy to .env for local overrides. Production default is https://api.smartlibdesk.in
VITE_API_URL=https://api.smartlibdesk.in

# Local dev only — Vite proxy target for `npm run dev` (default: http://127.0.0.1:1998)
# VITE_DEV_API_URL=http://127.0.0.1:1998

# Razorpay (must match backend RAZORPAY_KEY_ID)
# VITE_RAZORPAY_KEY_ID=rzp_test_...
