# Copy to .env for local overrides. Production default is https://sk-library-management.onrender.com
VITE_API_URL=https://sk-library-management.onrender.com

# Local dev only — Vite proxy target for `npm run dev` (default: http://127.0.0.1:1998)
# VITE_DEV_API_URL=http://127.0.0.1:1998

# Razorpay (must match backend RAZORPAY_KEY_ID; Key ID is public, never add the secret here)
# Production/live:
# VITE_RAZORPAY_TEST_ONLY=false
# VITE_RAZORPAY_KEY_ID=rzp_live_...
# Sandbox/test:
# VITE_RAZORPAY_TEST_ONLY=true
# VITE_RAZORPAY_KEY_ID=rzp_test_...
