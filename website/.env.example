# API base URL (no trailing slash). Baked in at build time (Vercel / Railway).
#
# Local dev (Vite proxies /api → this URL):
# VITE_API_URL=http://127.0.0.1:1998
#
# Vercel / production:
# VITE_API_URL=https://sk-library-management-production.up.railway.app

# Public Razorpay Key ID only — must match backend RAZORPAY_KEY_ID exactly.
# Production (real payments):  rzp_live_xxxxxxxx
# Sandbox (test payments):     rzp_test_xxxxxxxx
# NEVER add RAZORPAY_KEY_SECRET to the frontend.
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
