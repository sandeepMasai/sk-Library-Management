# API base URL (no trailing slash). Used by Vite dev proxy and production fetch.
#
# LOCAL PAYMENT TEST (recommended):
#   1. cd backend && npm run dev          → http://127.0.0.1:1998
#   2. Set RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET in backend/.env
#   3. Set VITE_RAZORPAY_KEY_ID to the SAME Key ID below
#   4. cd website && npm run dev          → proxies /api to backend
#   5. Verify keys: cd backend && node scripts/verify-razorpay.js
#
VITE_API_URL=http://127.0.0.1:1998

# PRODUCTION (Vercel website + Railway backend):
# VITE_API_URL=https://sk-library-management-production.up.railway.app
# Set the same RAZORPAY_KEY_ID on Railway AND VITE_RAZORPAY_KEY_ID on Vercel, then redeploy both.

# Optional: override Google Play listing URL
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.libdesk.app

# Local dev: phone QR scan (use Network URL from `npm run dev`, not localhost)
# VITE_DEV_ORIGIN=http://192.168.1.10:5173

# Razorpay: true = sandbox only (local dev). Production Vercel: false + rzp_live_*
VITE_RAZORPAY_TEST_ONLY=true

# Public key — must match backend RAZORPAY_KEY_ID. NEVER add RAZORPAY_KEY_SECRET here.
# Local: rzp_test_*  |  Production (Vercel): rzp_live_*  +  VITE_RAZORPAY_TEST_ONLY=false
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
