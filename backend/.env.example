# Copy to Railway Variables (or local: cp .env.example .env)
# Generate secrets: node scripts/generate-secrets.js

NODE_ENV=production

# Railway sets PORT automatically — do not hardcode in production.
HOST=0.0.0.0

# MongoDB Atlas (Network Access: allow 0.0.0.0/0 or Railway egress IPs)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/library_student_management?retryWrites=true&w=majority

# Super Admin login (change before production)
ADMIN_USERNAME=admin
ADMIN_PIN=change-me-min-8-chars
ADMIN_MOBILE=9000000000

# JWT — min 32 chars each in production (use generate-secrets.js)
AUTH_JWT_SECRET=
AUTH_REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=30d
# Legacy aliases (optional): ACCESS_TOKEN_TTL, REFRESH_TOKEN_TTL

# Behind Railway reverse proxy
TRUST_PROXY=true

# Browser CORS — required in production for website / Expo web (comma-separated, no trailing slash)
# ALLOWED_ORIGINS=https://your-website.vercel.app
# WEBSITE_URL=https://your-website.vercel.app
# CORS_ALLOW_VERCEL=true
# CORS_ALLOW_LOCALHOST=true
# CORS_CREDENTIALS=true

# Marketing website contact form (Resend)
# CONTACT_TO_EMAIL=you@example.com

# Optional: links in emails
# FRONTEND_URL=https://your-app.example.com

# Background jobs (recommended on Railway)
SUBSCRIPTION_CRON_ENABLED=true
EMAIL_OTP_CRON_ENABLED=true

# Optional integrations
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=noreply@smartlibdesk.in
# CONTACT_TO_EMAIL=support@smartlibdesk.in
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
